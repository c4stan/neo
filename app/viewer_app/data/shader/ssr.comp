layout ( local_size_x = 8, local_size_y = 8, local_size_z = 1 ) in;
void main ( void ) {
    vec2 screen_uv = compute_screen_uv_m ( draw_uniforms.resolution_f32 );

    // Sample
    vec4 norm_rough_sample = texture ( sampler2D ( tex_normal, sampler_point ), screen_uv );
    vec3 view_normal = normalize ( norm_rough_sample.xyz * 2 - 1 );
    float roughness = norm_rough_sample.w;
    vec4 mat_sample = texture ( sampler2D ( tex_material, sampler_point ), screen_uv );
    float depth = textureLod ( sampler2D ( tex_hiz, sampler_point ), screen_uv, 0 ).x;
    vec3 view_pos = view_from_depth ( screen_uv, depth );

    rng_wang_state_t rng_state = rng_wang_init ( gl_GlobalInvocationID.xy );
    vec3 wo = normalize ( -view_pos );
    //view_ray_dir = reflect ( normalize ( view_pos ), view_normal );
    //view_ray_dir = vec3 ( 0, 1, 1 );

    /*
        depth thickness:
            render objects to the usual depth prepass and gbuffer passes
            render objects to a new depth buffer using frontface culling and closest depth test
            render objects to the thickness buffer, depth equal with the first depth prepass (same way as a forward pass)
                but in the shader compare depth with sampled frontface culled depth, store difference in the thickness buffer
            sample thickness from the SSR shader to determine proper thickness value
    */

    // Trace
    float normal_offset = 0.01f;

#define SSRT_RAY_COUNT 1
    vec3 sample_screen_positions[SSRT_RAY_COUNT];
    vec3 sample_directions[SSRT_RAY_COUNT];
    float sample_distances[SSRT_RAY_COUNT];
    float sample_pdfs[SSRT_RAY_COUNT];
    bool hits[SSRT_RAY_COUNT];

    for ( uint i = 0; i < SSRT_RAY_COUNT; ++i ) {
        sample_screen_positions[i] = vec3 ( 0 );
        sample_distances[i] = 0;
        sample_pdfs[i] = 0;
        hits[i] = false;
    }

    //vec3 sample_color = vec3 ( 0, 0, 0 );
    //float hit_distance = 0;
    //float pdf = 0;
    //vec3 hit_screen_pos = vec3 ( 0, 0, 0 );
    bool ssr_enabled = mat_sample.x == 1;
    if ( ssr_enabled && !proj_depth_is_out ( depth ) ) {

        uint sample_it = 0;
        while ( sample_it < SSRT_RAY_COUNT ) {
            float ex = rng_wang ( rng_state );
            float ey = rng_wang ( rng_state );
            vec2 e2 = vec2 ( ex, ey );
            vec3 wi = ggx_sample_vndf ( e2, wo, view_normal, roughness );
            if ( dot ( wi, view_normal ) <= 0 ) {
                continue;
            }

            float pdf = ggx_vndf_pdf ( wi, wo, view_normal, roughness );
            if ( pdf <= 0 ) {
                continue;
            }

            sample_directions[sample_it] = wi;

            vec3 hit_screen_pos;
            float hit_depth;
            bool hit;
            hit = trace_screen_space_ray ( hit_screen_pos, hit_depth, view_pos + view_normal * normal_offset, wi, tex_hiz, draw_uniforms.hiz_mip_count, sampler_point, 100, 0.5 );

            if ( hit ) {
                //if ( length ( screen_uv - hit_screen_pos.xy ) < 0.01 ) {
                //    draw_debug_line ( img_color, screen_uv, hit_screen_pos.xy, vec4 ( 1, 0, 0, 1 ) );
                //}
                //vec3 hit_color = texture ( sampler2D ( tex_color, sampler_point ), hit_screen_pos.xy ).xyz;
                //hit_color = clamp ( hit_color, vec3(0), vec3(1) );
                //float depth_delta = - ( linearize_depth ( hit_screen_pos.z ) - linearize_depth ( hit_depth ) );
                //float depth_threshold = 0.4;
                //sample_color = mix ( hit_color, vec3 ( 0, 0, 0 ), clamp ( depth_delta, 0, depth_threshold ) * 1.f / depth_threshold );
                //sample_color = hit_color;
                vec3 hit_view_pos = view_from_screen ( hit_screen_pos );
                float hit_distance = length ( hit_view_pos - view_pos );
            
                sample_screen_positions[sample_it] = hit_screen_pos;
                sample_distances[sample_it] = hit_distance;
            }
            hits[sample_it] = hit;
            sample_pdfs[sample_it] = pdf;

            ++sample_it;
        }
    }

    vec4 color_metal_sample = texture ( sampler2D ( tex_color, sampler_point ), screen_uv );
    vec3 base_color = color_metal_sample.xyz;
    float metalness = color_metal_sample.w;

    vec3 final = vec3 ( 0 );
    vec3 wi_sum = vec3 ( 0.000001 );

    for ( uint sample_it = 0; sample_it < SSRT_RAY_COUNT; ++sample_it ) {
        vec3 hit_color = texture ( sampler2D ( tex_lighting, sampler_point ), sample_screen_positions[sample_it].xy ).xyz;
        vec3 f = brdf ( sample_directions[sample_it], view_normal, wo, base_color, roughness, metalness );
        float nl = dot ( view_normal, sample_directions[sample_it] );
        float pdf = sample_pdfs[sample_it];
        vec3 w = f / pdf;
        w = vec3 ( 1 );
        if ( hits[sample_it] ) 
        {
            final += hit_color * w * nl;
        }
        wi_sum += w;
    }

    //if ( wi_sum > 0 ) 
    {
        final /= wi_sum;
    }

    imageStore ( img_ssr_color, compute_screen_pixel_m(), vec4 ( final, 0 ) );

    vec3 hit_screen_pos = sample_screen_positions[0];
    vec3 wi = sample_directions[0];
    float pdf = sample_pdfs[0];
    float hit_distance = sample_distances[0];

    vec2 intersect_uv = snap_uv_to_pixel_center ( hit_screen_pos.xy, draw_uniforms.resolution_f32 * draw_uniforms.scale_f32 );
    imageStore ( img_ssr_uv, compute_screen_pixel_m(), vec4 ( intersect_uv, 0, 0 ) );
    imageStore ( img_ssr_wi, compute_screen_pixel_m(), vec4 ( normal_to_oct_encode ( wi ) * 0.5 + 0.5, 0, 0 ) );
    imageStore ( img_ssr_pdf, compute_screen_pixel_m(), vec4 ( pdf, 0, 0, 0 ) );
    imageStore ( img_ssr_dist, compute_screen_pixel_m(), vec4 ( hit_distance, 0, 0, 0 ) );
}
