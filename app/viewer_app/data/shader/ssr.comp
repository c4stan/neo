layout ( binding = 9, set = xs_shader_binding_set_dispatch_m, r16f ) uniform writeonly image2D img_ssr_dist;
layout ( binding = 10, set = xs_shader_binding_set_dispatch_m ) uniform writeonly image2D img_ssr_color; // TODO remove

layout ( binding = 11, set = xs_shader_binding_set_dispatch_m ) uniform sampler sampler_point;


