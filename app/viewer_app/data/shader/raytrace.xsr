begin ray_gen 0
    shader raytrace.rgen
end

begin ray_miss 0
    shader raytrace.rmiss
end

begin ray_hit 0
    hit_closest_shader raytrace.rchit
end

include common.xsi

begin bindings
    ray_world ray_gen ray_hit_closest
    buffer storage ray_hit_closest
    buffer[2] storage ray_gen
    texture[5] sampled
    texture[1] storage ray_gen
    sampler
end
